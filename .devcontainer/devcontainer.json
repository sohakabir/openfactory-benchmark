{
  "name": "OpenFactory-Benchmark — Benchmarking of OpenFactory",
  "image": "ghcr.io/openfactoryio/devcontainer-py3.14:v0.6.0",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:3.0.1": {},
    "ghcr.io/openfactoryio/openfactory-sdk/infra:0.6.0": {}, 
    "ghcr.io/openfactoryio/openfactory-sdk/opcua-connector:0.6.0": {}
  },
  "customizations": { 
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      },
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "containerEnv": {
    "OPENFACTORY_UNS_SCHEMA": "/workspaces/openfactory-benchmark/.devcontainer/uns.yml"
  }
}
